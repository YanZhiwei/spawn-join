# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Per-package virtual environments
.venv/
venv/

# Test, coverage, lint, and type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
coverage.xml
htmlcov/

# Python package build outputs
# Keep harness/build/ tracked: it contains governance documentation.
/build/
dist/
packages/**/build/

# Setuptools metadata
*.egg-info/
pip-wheel-metadata/

# Local Feature delivery artifacts; historical specs were untracked by ADR-0002 and stay local only.
/specs/

# Local secrets for model file configuration; only variable names belong in model.yaml.
/.env

# pyproject.toml, uv.lock, .python-version, and uv.toml are project inputs;
# keep them visible to Git when a Distribution uses them.
